{
  "schemaVersion": 1,
  "format": "meet-sieve-design-tokens/v1",
  "version": "1.5.0",
  "source": "tokens.css",
  "theme": "light",
  "tokens": {
    "color": {
      "primitive": {
        "neutral-white": "#ffffff",
        "neutral-25": "#fbfbfd",
        "neutral-50": "#f5f5f7",
        "neutral-100": "#e8e8ed",
        "neutral-300": "#d2d2d7",
        "neutral-500": "#86868b",
        "neutral-600": "#6e6e73",
        "neutral-750": "#424245",
        "neutral-900": "#1d1d1f",
        "blue-500": "#0077ed",
        "blue-600": "#0071e3",
        "blue-700": "#0066cc",
        "green-600": "#16a34a",
        "yellow-500": "#eab308",
        "red-600": "#dc2626"
      },
      "semantic": {
        "bg-page": "{color.primitive.neutral-50}",
        "bg-canvas": "{color.primitive.neutral-white}",
        "bg-sidebar": "{color.primitive.neutral-25}",
        "bg-subtle": "{color.primitive.neutral-50}",
        "bg-emphasis": "{color.primitive.neutral-900}",
        "text-primary": "{color.primitive.neutral-900}",
        "text-secondary": "{color.primitive.neutral-750}",
        "text-muted": "{color.primitive.neutral-600}",
        "text-meta": "{color.primitive.neutral-500}",
        "text-on-emphasis": "{color.primitive.neutral-white}",
        "border-default": "{color.primitive.neutral-300}",
        "border-soft": "{color.primitive.neutral-100}",
        "action-primary": "{color.primitive.blue-600}",
        "action-primary-hover": "{color.primitive.blue-500}",
        "action-primary-active": "{color.primitive.blue-700}",
        "action-on-primary": "{color.primitive.neutral-white}",
        "status-success": "{color.primitive.green-600}",
        "status-warning": "{color.primitive.yellow-500}",
        "status-danger": "{color.primitive.red-600}",
        "status-recording": "{color.primitive.red-600}",
        "status-info": "{color.primitive.blue-600}"
      }
    },
    "typography": {
      "font-family": {
        "display": "\"SF Pro Display\", \"SF Pro Icons\", \"Segoe UI Variable Display\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "body": "\"SF Pro Text\", \"SF Pro Icons\", \"Segoe UI Variable Text\", \"Segoe UI\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "mono": "\"SF Mono\", \"Cascadia Mono\", ui-monospace, \"JetBrains Mono\", Menlo, Monaco, Consolas, monospace"
      },
      "font-size": {
        "xs": "12px",
        "sm": "14px",
        "body": "17px",
        "title": "21px",
        "heading": "28px",
        "page-min": "32px",
        "page-max": "40px"
      },
      "line-height": {
        "body": 1.47,
        "heading": 1.14,
        "page": 1.08
      },
      "tracking": {
        "display": "-0.015em"
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "12": "48px"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "18px",
      "pill": "980px"
    },
    "size": {
      "control-sm": "36px",
      "control-md": "40px",
      "control-lg": "44px",
      "avatar": "36px",
      "toggle-width": "42px",
      "toggle-height": "24px",
      "status-dot": "7px"
    },
    "elevation": {
      "flat": "none",
      "ring": "0 0 0 1px var(--ms-border-default)",
      "raised": "0 12px 32px color-mix(in oklab, var(--ms-text-primary), transparent 92%)",
      "focus-ring": "0 0 0 4px color-mix(in oklab, var(--ms-action-primary), transparent 65%)"
    },
    "motion": {
      "fast": "150ms",
      "base": "220ms",
      "ease-standard": "cubic-bezier(0.28, 0, 0.22, 1)"
    },
    "layout": {
      "app-max-width": "1440px",
      "window-default-width": "1280px",
      "window-default-height": "800px",
      "window-min-width": "1024px",
      "window-min-height": "720px",
      "sidebar-width": "232px",
      "sidebar-width-compact": "196px",
      "titlebar-height": "52px",
      "content-max-width": "1120px",
      "settings-nav-width": "176px",
      "settings-nav-width-compact": "164px",
      "modal-max-width": "520px"
    },
    "z-index": {
      "modal": 40,
      "toast": 60
    }
  }
}
